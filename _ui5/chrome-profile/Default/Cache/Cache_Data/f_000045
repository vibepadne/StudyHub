  right: 1.35rem;
  bottom: 1rem;
  top: auto;
  left: auto;
  width: auto;
  height: auto;
  background: none;
  color: var(--ui-muted);
  font-family: var(--font-mono);
  font-size: 1rem;
  opacity: 0.45;
  transition: color 0.16s ease, transform 0.16s ease, opacity 0.16s ease;
}

.subject-card:hover::after {
  color: var(--ui-accent);
  opacity: 1;
  transform: translate(2px, -2px);
}

.subject-card h3 {
  max-width: 22ch;
  margin-bottom: 0.6rem;
  font-family: var(--font-display);
  font-size: 1.38rem;
  line-height: 1.15;
  letter-spacing: -0.025em;
}

.subject-meta {
  color: var(--ui-muted);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.03em;
  line-height: 1.7;
}

.subject-meta + .subject-meta {
  color: color-mix(in srgb, var(--ui-muted) 82%, transparent);
}

.subject-select {
  top: 1.2rem;
  right: 1.2rem;
}

/* Subject panel */
.panel-header {
  align-items: flex-end;
  padding-bottom: 1.5rem;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid var(--ui-line);
}

.panel-header .back-link {
