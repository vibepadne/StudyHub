  padding: 1.7rem;
}

.profile-card h1 {
  font-size: clamp(2rem, 3vw, 2.5rem);
  letter-spacing: -0.04em;
}

.profile-avatar-section {
  padding: 1.1rem;
  border: 1px solid var(--ui-line);
  border-radius: 10px;
  background: var(--ui-surface-2);
}

.avatar-clickable,
.profile-avatar-preview {
  border: 2px solid var(--ui-accent);
  background: var(--ui-surface-2);
  box-shadow: none;
}

.avatar-clickable:hover {
  box-shadow: 0 0 0 4px var(--ui-accent-soft);
}

.avatar-initials,
.avatar-initials-lg {
  background: var(--ui-accent);
  color: var(--ui-accent-ink) !important;
  font-family: var(--font-mono);
  font-weight: 700;
}

.avatar-overlay {
  background: color-mix(in srgb, var(--ui-bg) 82%, transparent);
  color: var(--ui-text);
  font-family: var(--font-mono);
  font-size: 0.64rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.profile-meta strong {
  font-family: var(--font-display);
  font-size: 1.3rem;
  letter-spacing: -0.02em;
}

.profile-side h3 {
  color: var(--ui-muted);
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.16em;
}

.profile-details dt {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.profile-details dd {
  font-size: 1rem;
}

.security-section {
  border-top-color: var(--ui-line);
}

.security-section .profile-form + .profile-form {
  border-top-color: var(--ui-line);
}

.avatar-menu {
  border: 1px solid var(--ui-line);
  background: var(--ui-surface);
  border-radius: 9px;
  box-shadow: var(--shadow-lift);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.avatar-menu-item {
  font-size: 0.84rem;
}

.auth-card {
  position: relative;
  max-width: 470px;
  margin: clamp(3.5rem, 9vh, 6.5rem) auto;
  padding: 2.4rem;
  overflow: hidden;
}

body.auth-page .container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 2rem;
  padding-bottom: 2rem;
}

body.auth-page .auth-card {
  width: 100%;
  margin: 0 auto;
}

.auth-card h1::before {
  content: "StudyHub / Account";
  display: block;
  margin-bottom: 0.7rem;
  color: var(--ui-muted);
  font-family: var(--font-mono);
  font-size: 0.62rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.auth-card::before,
.share-card::before,
.lock-card--styled::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--ui-accent);
}

.auth-card h1 {
  font-size: clamp(2rem, 3vw, 2.5rem);
  letter-spacing: -0.04em;
}

.auth-card form {
  margin-top: 1.2rem;
}

.auth-card .btn-block {
  margin-top: 1.2rem;
}

.auth-card a {
  color: var(--ui-text);
  text-decoration-color: var(--ui-accent);
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
}

.share-wrap {
  max-width: 690px;
}

.share-card {
  position: relative;
  padding: 2rem 2rem 2.1rem;
  overflow: hidden;
}

.share-card h1 {
  font-size: clamp(1.8rem, 3vw, 2.3rem);
  letter-spacing: -0.035em;
}

.lock-card--styled {
  position: relative;
  overflow: hidden;
  border-color: var(--ui-line);
  background: var(--ui-surface);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  box-shadow: var(--shadow-lift);
}

.lock-icon-wrap {
  border: 1px solid color-mix(in srgb, var(--ui-accent) 30%, var(--ui-line));
  background: color-mix(in srgb, var(--ui-accent) 8%, transparent);
  box-shadow: none;
}

.lock-title {
  font-family: var(--font-display);
  letter-spacing: -0.03em;
}

.lock-form input {
  background: var(--ui-surface-2);
  border-color: var(--ui-line);
}

.modal-backdrop {
  background: color-mix(in srgb, #000 68%, transparent);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.modal-box {
  border: 1px solid var(--ui-line);
  background: var(--ui-surface);
  box-shadow: var(--shadow-lift);
}

/* --------------------------------------------------------------------------
   12. Command palette / AI / toasts
   -------------------------------------------------------------------------- */

.cmdk-backdrop {
  background: color-mix(in srgb, #000 68%, transparent);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.cmdk {
  border: 1px solid var(--ui-line-strong);
  background: var(--ui-surface);
  box-shadow: var(--shadow-lift);
}

.cmdk-input-row {
  border-bottom-color: var(--ui-line);
}

.cmdk-mode-badge {
  border: 1px solid var(--ui-accent);
  background: var(--ui-accent);
  color: var(--ui-accent-ink);
  font-family: var(--font-mono);
  font-size: 0.64rem;
  letter-spacing: 0.04em;
}

.cmdk-input-row input {
  font-size: 1rem;
}

.cmdk-item {
  border-radius: 7px;
}

.cmdk-item:hover,
.cmdk-item.active {
  background: var(--ui-surface-2);
  box-shadow: inset 2px 0 0 var(--ui-accent);
}

.cmdk-icon {
  filter: grayscale(1);
  opacity: 0.78;
}

.cmdk-title {
  font-weight: 600;
}

.cmdk-snippet {
  color: var(--ui-accent);
}

.cmdk-hints {
  border-top-color: var(--ui-line);
  font-family: var(--font-mono);
  font-size: 0.64rem;
}

.cmdk-ai-msg {
  border: 1px solid var(--ui-line);
  background: var(--ui-surface-2);
}

kbd,
.cmdk-hints kbd {
  border: 1px solid var(--ui-line);
  background: var(--ui-surface-2);
  color: var(--ui-muted);
  font-family: var(--font-mono);
}

.ai-dock {
  position: fixed;
  left: 0;
  right: auto;
  top: 50%;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  transform: translateY(-50%);
}

.ai-dock-toggle {
  display: none;
}

.ai-tab {
  position: static;
  top: auto;
  left: auto;
  right: auto;
  transform: none;
  writing-mode: vertical-rl;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1rem 0.55rem;
  border: 1px solid var(--ui-accent);
  border-left: none;
  border-radius: 0 10px 10px 0;
  background: var(--ui-surface);
  color: var(--ui-accent);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.06em;
  box-shadow: 0 16px 34px -18px #000;
}

.ai-tab:hover {
  background: var(--ui-accent);
  color: var(--ui-accent-ink);
}

.ai-dock-toggle:hover {
  background: var(--ui-surface-2);
}

.ai-drawer {
  border-right: 1px solid var(--ui-line);
  background: var(--ui-surface);
  box-shadow: var(--shadow-lift);
}

.ai-head {
  border-bottom-color: var(--ui-line);
}

.ai-head strong {
  font-family: var(--font-display);
  font-size: 1.1rem;
}

.ai-subject {
  font-family: var(--font-mono);
  font-size: 0.62rem;
}

.ai-close {
  border-radius: 7px;
}

.ai-messages {
  background: var(--ui-bg);
}

.ai-msg-bot {
  background: var(--ui-surface-2);
  border-color: var(--ui-line);
}

.ai-msg-user {
  background: color-mix(in srgb, var(--ui-accent) 16%, transparent);
  border-color: color-mix(in srgb, var(--ui-accent) 38%, transparent);
}

.ai-input-row {
  border-top-color: var(--ui-line);
  background: var(--ui-surface);
}

.ai-input-row textarea {
  background: var(--ui-surface-2);
}

.instant-toast {
  border: 1px solid var(--ui-accent);
  background: var(--ui-accent);
  color: var(--ui-accent-ink);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.02em;
  box-shadow: 0 18px 38px -18px #000;
}

.instant-toast--error {
  background: var(--ui-danger);
  border-color: var(--ui-danger);
  color: #ffffff;
}

.badge-optimistic {
  background: var(--ui-accent);
  color: var(--ui-accent-ink);
  border-color: var(--ui-accent);
}

.optimistic-failed .badge-optimistic {
  background: var(--ui-danger);
  color: #ffffff;
}

/* --------------------------------------------------------------------------
   13. Responsive polish
   -------------------------------------------------------------------------- */

@media (min-width: 769px) {
  .container {
    max-width: 1240px;
    padding: 2.5rem 2rem 3rem;
  }
}

@media (max-width: 1100px) {
  .container {
    padding-left: 1.4rem;
    padding-right: 1.4rem;
  }
}

@media (max-width: 1024px) {
  .nav-inner .nav-search {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    min-width: 44px;
    padding: 0;
    justify-content: center;
    border-radius: 10px;
  }

  .nav-search-label,
  .nav-search kbd {
    display: none;
  }
}

@media (max-width: 900px) {
  .container {
    padding: 1.5rem 1.1rem 2rem;
  }

  .nav-select-toggle {
    height: 44px;
  }

  .theme-opt {
    width: 42px;
    height: 38px;
  }

  .hero {
    padding-top: 2.6rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 8.4vw, 3rem);
  }

  .dashboard-header {
    align-items: flex-start;
  }

  .subjects-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }

  .panel-header {
    align-items: flex-start;
  }
}

@media (max-width: 768px) {
  .container {
    padding: 1.1rem 0.85rem 1.6rem;
  }

  body.shared-page.shared-sidebar-collapsed .container {
    padding-top: 4.35rem;
  }

  .viewer-toc-toggle {
    width: 2.75rem;
    height: 2.75rem;
  }

  .ai-dock {
    left: 0;
    right: auto;
    top: 50%;
  }

  .ai-dock-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--ui-accent);
    border-left: none;
    border-radius: 0 10px 10px 0;
    background: var(--ui-surface);
    color: var(--ui-accent);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 16px 34px -18px #000;
  }

  .ai-tab {
    display: none;
    writing-mode: horizontal-tb;
    min-height: 44px;
    padding: 0.7rem 0.9rem;
    border-left: none;
    border-right: 1px solid var(--ui-accent);
    border-radius: 0 10px 10px 0;
  }

  .ai-dock.is-open .ai-tab {
    display: inline-flex;
  }

  .ai-dock.is-open .ai-dock-toggle {
    display: none;
  }

  .sidebar-toggle,
  .cmdk-item {
    min-height: 44px;
  }

  /* The topic composer stays a compact single row instead of stretching a
     full-width field down the whole card. */
  #topic-form {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 0.45rem;
  }

  #topic-form input[name="name"] {
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
  }

  #topic-form .btn {
    flex: 0 0 auto;
    width: auto;
    padding-inline: 0.85rem;
    white-space: nowrap;
  }

  /* The optional title is a normal companion to Upload, not a full-width
     banner. The file picker keeps its own full row. */
  .upload-form {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.45rem;
  }

  .upload-form input[type="file"] {
    flex: 1 1 100%;
    width: 100%;
  }

  .upload-form input[name="title"] {
    flex: 1 1 0;
    width: auto;
    min-width: 0;
  }

  .upload-form button[type="submit"] {
    flex: 0 0 auto;
    width: auto;
    padding-inline: 0.85rem;
    white-space: nowrap;
  }

  .pdf-frame {
    height: 82vh;
    height: 82dvh;
    min-height: 460px;
  }

  .auth-card {
    padding: 1.8rem 1.1rem;
    margin-top: 1.8rem;
  }

  .brand {
    font-size: 1.12rem;
  }

  .brand::before {
    width: 26px;
    height: 26px;
    font-size: 0.74rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 9vw, 2.6rem);
  }

  .hero .lead {
    font-size: 0.98rem;
  }

  .features {
    margin-top: 2rem;
    padding-top: 2rem;
  }

  .features .feature-card {
    padding: 1.4rem 1.2rem;
  }

  .features .feature-card h3::after {
    top: 1.4rem;
    right: 1.2rem;
  }

  .dashboard-header {
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .dashboard-header h1 {
    font-size: 2rem;
  }

  .subject-card {
    padding: 1.2rem 1.15rem 2.6rem;
  }

  .subject-card h3 {
    font-size: 1.25rem;
  }

  .topic-card {
    padding: 1.1rem;
  }

  .topic-name {
    font-size: 1.18rem;
  }

  .topic-head h3 {
    flex-wrap: wrap;
    row-gap: 0.2rem;
  }

  .viewer-header {
    padding-left: 0.9rem;
  }

  .viewer-header h1 {
    font-size: clamp(1.5rem, 6vw, 2rem);
  }

  .material-head h3 {
    font-size: 1.08rem;
  }

  .viewer-toc-toggle {
    width: 2.75rem;
    height: 2.75rem;
  }

  .auth-card {
    padding: 1.8rem 1.1rem;
    margin-top: 1.8rem;
  }

  .share-card {
    padding: 1.5rem 1.1rem;
  }

  .profile-card {
    padding: 1.25rem;
  }

  .share-group-head strong {
    font-size: 1.02rem;
  }

  .shared-selection-bar {
    padding: 0.7rem 0.85rem;
  }
}

@media (max-width: 520px) {
  .dashboard-header {
    align-items: stretch;
  }

  .hero h1 {
    font-size: clamp(1.85rem, 10vw, 2.35rem);
  }

  .hero-eyebrow {
    font-size: 0.56rem;
    letter-spacing: 0.1em;
  }

  .pdf-frame {
    height: 78vh;
    height: 78dvh;
    min-height: 420px;
  }

  .dashboard-header h1 {
    font-size: 1.75rem;
  }

  .feature-card h3 {
    font-size: 1.08rem;
  }

  .viewer-header {
    border-left: none;
    padding-left: 0;
  }

  .auth-card h1 {
    font-size: 1.8rem;
  }

  .share-card h1 {
    font-size: 1.55rem;
  }

  .back-to-top {
    font-size: 0.64rem;
  }
}

[data-theme="light"] .nav-search kbd,
[data-theme="light"] .back-link:hover,
[data-theme="light"] .topic-head h3::before,
[data-theme="light"] .viewer-topic h2::before,
[data-theme="light"] .viewer-toc a:hover,
[data-theme="light"] .toc-doc-link:hover,
[data-theme="light"] .material-list a:hover,
[data-theme="light"] .sidebar-toggle-icon,
[data-theme="light"] .cmdk-snippet,
[data-theme="light"] .ai-tab,
[data-theme="light"] .ai-dock-toggle,
[data-theme="light"] .hero-trust-sep,
[data-theme="light"] .footer p::before {
  color: #5b6d00;
}

[data-theme="light"] .ai-tab:hover {
  color: var(--ui-accent-ink);
}

@media (max-width: 900px) and (max-height: 520px) {
  .pdf-frame {
    height: 70vh;
    height: 70dvh;
    min-height: 260px;
  }
}

@media (hover: none) {
  .subject-card:hover {
    transform: none;
    background: var(--ui-surface);
    border-color: var(--ui-line);
    border-left-color: var(--ui-line) !important;
    box-shadow: inset 3px 0 0 var(--ui-accent), var(--shadow);
  }

  .features .feature-card:hover,
  .features .feature-card:focus-visible {
    transform: none;
    background: var(--ui-surface);
    border-color: var(--ui-line);
    box-shadow: var(--shadow);
  }

  .features .feature-card:hover .feature-icon,
  .features .feature-card:focus-visible .feature-icon {
    background: var(--ui-accent);
    border-color: var(--ui-accent);
  }

  .features .feature-card:hover .feature-icon svg,
  .features .feature-card:focus-visible .feature-icon svg {
    color: var(--ui-accent-ink);
  }

  .btn:hover {
    transform: none;
  }

  .material-list li:hover {
    background: transparent;
    box-shadow: none;
  }

  .viewer-toc ol > li:hover,
  .toc-docs li:hover {
    background: transparent;
    border-color: transparent;
  }

  .doc-option:hover,
  .topic-option:hover {
    background: transparent;
  }
}

/* --------------------------------------------------------------------------
   14. Shared page centering
   -------------------------------------------------------------------------- */

@media (min-width: 1101px) {
  /* The filters sidebar is fixed, so let the page container own the full
     area to its right and center one column there. */
  body.shared-page:not(.shared-sidebar-collapsed) .container {
    width: auto;
    max-width: none;
    margin-left: 264px;
    margin-right: 0;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  body.shared-page.shared-sidebar-collapsed .container {
    width: auto;
    max-width: none;
    margin-left: 0;
    margin-right: 0;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  /* Header and list share the exact same width and centre line. */
  body.shared-page .page-head,
  body.shared-page .shared-main-content {
    width: 100%;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }
}

@media (max-width: 1100px) {
  /* Below the desktop drawer breakpoint the sidebar is hidden, but the old
     rules gave the header 90% auto margins and the list a hard-left margin.
     Normalize both to the same full-width, equally padded column. */
  body.shared-page .page-head,
  body.shared-page .shared-main-content {
    width: 100% !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 1rem !important;
    padding-right: 1rem !important;
  }
}

/* --------------------------------------------------------------------------
   15. Motion / reduced motion
   -------------------------------------------------------------------------- */

.feature-card,
.subject-card,
.topic-card,
.material-block,
.doc-option,
.topic-option,
.cmdk-item,
.btn,
input,
select,
textarea,
.nav-links > a {
  transition-property: background-color, border-color, color, box-shadow, opacity, transform;
  transition-duration: 0.16s;
  transition-timing-function: ease;
}

@media (prefers-reduced-motion: reduce) {
  .feature-card,
  .subject-card,
  .topic-card,
  .material-block,
  .doc-option,
  .topic-option,
  .cmdk-item,
  .btn,
  .nav-links > a,
  .scroll-progress span {
    transition: none !important;
  }

  .feature-card:hover,
  .subject-card:hover {
    transform: none !important;
  }
}
