}

/* Let the topic/subject creation fields take the available row width on
   desktop, without stretching them vertically on the mobile column layout. */
@media (min-width: 769px) {
  #topic-form input[name="name"],
  #subject-form input[name="name"],
  #subject-form input[name="class_level"] {
    flex: 1 1 220px;
