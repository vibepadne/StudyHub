.features {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.05rem;
  max-width: 1020px;
  margin: 2.4rem auto 0;
  padding-top: 2.4rem;
  border-top: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
  position: relative;
  perspective: 1100px;
}
.features::before {
  content: "";
  position: absolute;
  top: -1px;
  left: 50%;
  transform: translateX(-50%);
  width: 120px;
  height: 1px;
  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ink) 22%, transparent), transparent);
}
.features .feature-card {
  --mx: 50%;
  --my: 0%;
  position: relative;
  isolation: isolate;
  background: var(--surface-glass);
  backdrop-filter: blur(16px) saturate(1.3);
  -webkit-backdrop-filter: blur(16px) saturate(1.3);
  border: 1px solid var(--border-glass);
  border-radius: var(--radius);
  padding: 1.7rem 1.5rem 1.6rem;
  box-shadow: var(--shadow), inset 0 1px 0 color-mix(in srgb, var(--ink) 7%, transparent);
  overflow: hidden;
  text-align: left;
  outline: none;
  cursor: default;
  will-change: transform;
  transition:
    transform 0.28s cubic-bezier(0.22,0.61,0.36,1),
    box-shadow 0.28s ease,
    border-color 0.28s ease,
    background-color 0.28s ease,
    opacity 0.55s ease;
}
/* Entrance stagger — only while reveal hasn't fired yet, so hover stays snappy */
.features .feature-card:nth-child(1):not(.revealed) { transition-delay: 0.05s, 0.05s, 0.05s, 0.05s, 0.08s; }
.features .feature-card:nth-child(2):not(.revealed) { transition-delay: 0.05s, 0.05s, 0.05s, 0.05s, 0.16s; }
.features .feature-card:nth-child(3):not(.revealed) { transition-delay: 0.05s, 0.05s, 0.05s, 0.05s, 0.24s; }
.features .feature-card > *:not(.feature-shine) { position: relative; z-index: 1; }
/* Mouse spotlight — follows cursor, same monochrome glass language */
.features .feature-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background: radial-gradient(340px circle at var(--mx) var(--my), color-mix(in srgb, var(--ink) 11%, transparent), transparent 65%);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}
/* Top hairline — brightens + widens on hover */
.features .feature-card::after {
  content: "";
  position: absolute;
  top: 0;
  left: 1.25rem;
  right: 1.25rem;
  height: 1px;
  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ink) 11%, transparent), transparent);
  opacity: 0.85;
  transition: opacity 0.28s ease, left 0.28s ease, right 0.28s ease;
  pointer-events: none;
}
/* Diagonal shine sweep on hover */
.features .feature-shine {
  position: absolute;
  inset: -40%;
  z-index: 0;
  background: linear-gradient(105deg, transparent 44%, color-mix(in srgb, var(--ink) 7%, transparent) 50%, transparent 56%);
  transform: translateX(-38%);
  opacity: 0;
  pointer-events: none;
}
.features .feature-card:hover,
.features .feature-card:focus-visible {
  transform: translateY(-6px);
  border-color: color-mix(in srgb, var(--ink) 22%, transparent);
  background-color: color-mix(in srgb, var(--ink) 7.5%, transparent);
  box-shadow:
    var(--shadow-lift),
    0 0 0 1px color-mix(in srgb, var(--ink) 5%, transparent) inset,
    0 0 28px color-mix(in srgb, var(--ink) 7%, transparent);
}
.features .feature-card:hover::before,
.features .feature-card:focus-visible::before { opacity: 1; }
.features .feature-card:hover::after,
.features .feature-card:focus-visible::after { left: 0.6rem; right: 0.6rem; opacity: 1; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ink) 28%, transparent), transparent); }
.features .feature-card:hover .feature-shine,
.features .feature-card:focus-visible .feature-shine { opacity: 1; transform: translateX(38%); transition: transform 0.9s ease, opacity 0.3s ease; }
.features .feature-card:active { transform: translateY(-2px) scale(0.995); }
.features .feature-card:focus-visible { box-shadow: var(--shadow-lift), 0 0 0 2px color-mix(in srgb, var(--ink) 35%, transparent), 0 0 28px color-mix(in srgb, var(--ink) 8%, transparent); }
@media (hover: none), (pointer: coarse) {
  .features .feature-card:hover { transform: none; background-color: var(--surface-glass); }
  .features .feature-shine { display: none; }
}
