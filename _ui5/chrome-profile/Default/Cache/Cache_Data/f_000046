  padding: 0.28rem 0.7rem;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
  background: color-mix(in srgb, var(--ink) 10%, transparent);
  white-space: nowrap;
}
.cmdk-input-row input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text);
  font-size: 1.02rem;
  font-family: inherit;
}
.cmdk-input-row input::placeholder { color: var(--muted); }
kbd, .cmdk-hints kbd {
  font-family: inherit;
  font-size: 0.68rem;
  padding: 0.14rem 0.42rem;
  border-radius: 6px;
  border: 1px solid var(--border-glass);
  background: color-mix(in srgb, var(--ink) 6%, transparent);
  color: var(--muted);
}
.cmdk-results {
  overflow-y: auto;
  padding: 0.55rem 0.55rem 0.75rem;
  flex: 1;
}
.cmdk-idle {
  color: var(--muted);
  font-size: 0.88rem;
  text-align: center;
  padding: 1.3rem 0.8rem;
}
.cmdk-idle.cmdk-error { color: var(--danger-text); }
.cmdk-group-label {
  font-size: 0.68rem;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: var(--muted);
  padding: 0.65rem 0.6rem 0.3rem;
}
.cmdk-item {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  width: 100%;
  text-align: left;
  padding: 0.5rem 0.6rem;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text);
  cursor: pointer;
  font-family: inherit;
}
.cmdk-item.active { background: color-mix(in srgb, var(--ink) 12%, transparent); }
.cmdk-icon { flex-shrink: 0; width: 1.35rem; text-align: center; }
.cmdk-texts { display: flex; flex-direction: column; gap: 0.08rem; min-width: 0; }
.cmdk-title {
  font-size: 0.92rem;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cmdk-snippet {
  font-size: 0.78rem;
  color: var(--blue);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cmdk-sub { font-size: 0.76rem; color: var(--muted); }
.cmdk-hints {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  padding: 0.55rem 1rem;
  border-top: 1px solid var(--border-glass);
  font-size: 0.72rem;
  color: var(--muted);
}
.cmdk-hints span { display: inline-flex; align-items: center; gap: 0.32rem; }
.cmdk-ai-msg {
  margin: 0.45rem 0.6rem;
  padding: 0.65rem 0.85rem;
  border-radius: var(--radius-sm);
  background: color-mix(in srgb, var(--ink) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
  font-size: 0.88rem;
  line-height: 1.5;
  word-wrap: break-word;
}
.cmdk-ai-msg.typing { padding: 0.55rem 0.85rem; }
.cmdk-ai-msg.error { background: color-mix(in srgb, var(--ink) 10%, transparent); border-color: color-mix(in srgb, var(--ink) 35%, transparent); }
.cmdk-ai-msg pre.cmdk-ai-code {
  margin: 0.45rem 0;
  padding: 0.6rem 0.75rem;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.35);
  overflow-x: auto;
  font-family: "Consolas", monospace;
  font-size: 0.8rem;
}
.cmdk-ai-msg code {
  font-family: "Consolas", monospace;
  font-size: 0.82rem;
  padding: 0.05rem 0.3rem;
  border-radius: 5px;
  background: rgba(0, 0, 0, 0.3);
}
/* ── Instant optimistic feedback (Enter → feels done) ───────────────── */
#instant-toast-host {
  position: fixed;
  top: calc(var(--nav-h) + 0.55rem);
  left: 50%;
  transform: translateX(-50%);
  z-index: 70;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  pointer-events: none;
}
.instant-toast {
  padding: 0.6rem 1rem;
  border-radius: 999px;
  background: var(--acev);
  color: var(--bg);
  font-size: 0.88rem;
  font-weight: 600;
  box-shadow: 0 8px 32px rgba(0,0,0,0.35), 0 0 0 1px color-mix(in srgb, var(--ink) 60%, transparent);
  opacity: 0;
  transform: translateY(-8px);
  transition: opacity 0.22s ease, transform 0.22s ease;
}
.instant-toast.is-visible { opacity: 1; transform: translateY(0); }
.instant-toast--error { background: var(--acev); color: #7a1a1a; border: 1px solid rgba(122,26,26,0.15); }
.badge-optimistic {
  background: var(--acev);
  color: var(--bg);
  border-color: var(--text);
  font-weight: 700;
  animation: pulseOptimistic 1.2s ease infinite;
}
@keyframes pulseOptimistic { 0%,100% { opacity: 1; } 50% { opacity: 0.72; } }
.optimistic-item { border-style: dashed; border-color: color-mix(in srgb, var(--ink) 28%, transparent); }
.optimistic-done { border-style: solid; opacity: 1 !important; }
.optimistic-done .badge-optimistic { animation: none; background: rgba(111,224,168,0.18); color: #6fe0a8; border-color: rgba(111,224,168,0.5); }
.optimistic-failed { border-color: rgba(255,109,90,0.5); }
.optimistic-failed .badge-optimistic { animation: none; background: rgba(255,109,90,0.18); color: #ff6d5a; border-color: rgba(255,109,90,0.5); }

/* ── Theme switch (navbar segmented pill) ─────────────────────── */
.theme-switch {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  padding: 3px;
  border-radius: 999px;
  border: 1px solid var(--border-glass);
  background: var(--surface-glass);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  flex-shrink: 0;
  line-height: 1;
}
.theme-opt {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 28px;
  padding: 0;
  border: none;
  border-radius: 999px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-family: inherit;
  transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
}
.theme-opt svg { width: 15px; height: 15px; display: block; }
.theme-opt:hover { color: var(--text); background: var(--surface-glass-strong); transform: translateY(-1px); }
.theme-opt.active {
  background: var(--acev);
  color: var(--bg);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
}
.theme-opt:focus-visible { outline: none; box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 45%, transparent); }

/* ── Functional keepers (theme-critical, not decorative) ──────── */
/* White initials like the original dark look; visible on slate tiles in light */
.avatar-initials,
.avatar-initials-lg { color: #fff !important; }
[data-theme="light"] .instant-toast--error { color: #FFB4AB; border-color: rgba(255, 138, 128, 0.42); }
[data-theme="light"] .navbar { background: color-mix(in srgb, #ffffff 78%, transparent); }
[data-theme="light"] .txt-viewer { background: rgba(17, 20, 38, 0.05); }
[data-theme="light"] .download-card { background: rgba(17, 20, 38, 0.04); }
[data-theme="light"] .image-frame { box-shadow: 0 12px 42px rgba(23, 28, 54, 0.16); }
[data-theme="light"] .cmdk-ai-msg,
[data-theme="light"] .cmdk-ai-msg code { background: rgba(17, 20, 38, 0.05); }
