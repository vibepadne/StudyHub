  <script>
    (() => {
      const path = location.pathname.replace(/\/+$/, "") || "/";
      document.querySelectorAll(".nav-links a[href]").forEach((link) => {
        try {
          const url = new URL(link.href, location.origin);
          if (url.origin !== location.origin) return;
          const target = url.pathname.replace(/\/+$/, "") || "/";
          const inLibrary =
            path === "/dashboard" ||
            path.startsWith("/dashboard/") ||
            path.startsWith("/viewer/") ||
            path.startsWith("/share/") ||
            (path.startsWith("/shared/combined") &&
              new URLSearchParams(location.search).get("from") === "topics");
          const active =
            target === path ||
            (target === "/dashboard" && inLibrary) ||
            (target === "/shared" &&
              path.startsWith("/shared/") &&
              !inLibrary) ||
            (target === "/profile" && path.startsWith("/profile"));
          if (active) link.setAttribute("aria-current", "page");
        } catch (e) {}
      });
    })();
  </script>
  <script>
    (() => {
      const bar = document.getElementById("scroll-progress");
      if (!bar) return;
      const fill = bar.firstElementChild;
      const main = document.getElementById("viewer-main");
      let ticking = false;
      const update = () => {
        const winMax = document.documentElement.scrollHeight - window.innerHeight;
        const winY = window.scrollY || 0;
        const mainMax = main ? Math.max(0, main.scrollHeight - main.clientHeight) : 0;
        const mainY = main ? main.scrollTop || 0 : 0;
        const max = Math.max(winMax, mainMax);
        const y = Math.max(winY, mainY);
        const progress = max > 0 ? Math.min(1, Math.max(0, y / max)) : 0;
        fill.style.transform = `scaleX(${progress})`;
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      if (main) main.addEventListener("scroll", onScroll, { passive: true });
      update();
    })();
  </script>
  <script>
    (() => {
      const buttons = document.querySelectorAll(
        ".viewer-toc-reopen, .shared-sidebar-reopen"
      );
      if (!buttons.length) return;
      const idleDelay = () =>
        window.matchMedia("(max-width: 768px)").matches ? 1000 : 2000;
      let timer = null;
      const wake = () => {
        buttons.forEach((btn) => btn.classList.remove("is-idle"));
        if (timer) clearTimeout(timer);
        timer = setTimeout(() => {
          timer = null;
          buttons.forEach((btn) => btn.classList.add("is-idle"));
        }, idleDelay());
      };
      ["pointermove", "mousemove", "pointerdown", "keydown", "touchmove", "wheel", "scroll"].forEach((type) => {
        window.addEventListener(type, wake, { passive: true });
      });
      const viewerMain = document.getElementById("viewer-main");
      if (viewerMain) viewerMain.addEventListener("scroll", wake, { passive: true });
      if (document.readyState === "complete") {
        wake();
      } else {
        window.addEventListener("load", wake, { once: true });
      }
    })();
  </script>

